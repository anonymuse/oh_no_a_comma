{
  "name": "demo-careers-location-walkthrough",
  "version": "1.0.0",
  "description": "Anonymized Vite React TypeScript walkthrough for a location-filter normalization defect and fix",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test && npm run graph:cypher",
    "e2e": "playwright test",
    "demo:screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "demo:record": "playwright test tests/e2e/screenshots.spec.ts --project=chromium-video",
    "graph:cypher": "tsx scripts/generateNeo4jCypher.ts"
  },
  "keywords": [
    "frontend",
    "data-quality",
    "normalization",
    "vite",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.14",
    "vitest": "^1.0.0"
  }
}
